[Unit]
Description=rdphiro Remote Desktop & Device Management Server
After=network.target

[Service]
Type=simple
User=rdphiro
Group=rdphiro
WorkingDirectory=/opt/rdphiro
ExecStart=/usr/bin/node /opt/rdphiro/meshcentral.js --datapath /opt/rdphiro/meshcentral-data
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rdphiro
Environment=NODE_ENV=production

# Security sandbox settings
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
